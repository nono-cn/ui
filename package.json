{
  "name": "@nono/ui",
  "version": "0.0.0",
  "description": "Librería de componentes sobre ui-sdk: lógica agnóstica y adaptadores por framework",
  "license": "ISC",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.ts",
    "build": "vite build",
    "build:docs": "vite build --config vite.docs.config.ts",
    "preview": "vite preview --config vite.docs.config.ts",
    "browser:up": "docker compose up -d playwright",
    "browser:down": "docker compose down",
    "pretest": "npm run browser:up",
    "test": "vitest run",
    "pretest:update": "npm run browser:up",
    "test:update": "vitest run --update=all",
    "pretest:watch": "npm run browser:up",
    "test:watch": "vitest",
    "pretest:coverage": "npm run browser:up",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -p tsconfig.core.json --noEmit && vue-tsc -p tsconfig.vue.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@ui-sdk/vue": "0.1.0-beta.1",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@ui-sdk/vue": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.0",
    "@ui-sdk/vue": "0.1.0-beta.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "1.65.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.10",
    "vitest-browser-vue": "3.1.0",
    "vue": "^3.5.39",
    "vue-tsc": "^3.2.5"
  }
}
